# ---- caches / virtual envs ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/
.env
node_modules/
.DS_Store

# ---- archives & large binaries ----
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.xlsx
*.xls
*.parquet
*.pkl
*.bin
*.mp4

# ---- large data & generated pipeline outputs ----
data/
**/data/outputs/
**/data/crf_forms/
**/reference_recipes/

# ---- throwaway / probe scripts & logs ----
tmp/
tmp_*.py
tmp_*.sh
tmp_*.txt
tmp_*.ps1
*.log

# ---- nested repo / backups (kept outside git history) ----
ECSGENERATION/project_config/
ECSGENERATION/backup/

# ---- keep the reconstructed project history in full, even though the ----
# ---- patterns above would otherwise drop its snapshots ----
!experiments/recipe_prototype/project_history/
!experiments/recipe_prototype/project_history/**

# ---- structured project home: track the crf_codegen folder (code + docs + ----
# ---- curated history + interpretable per-run artifacts), overriding the ----
# ---- data/, *.png, *.xlsx and *.log rules above for this subtree only ----
!experiments/crf_codegen/
!experiments/crf_codegen/**
# ...but never commit caches inside it
experiments/crf_codegen/**/__pycache__/
experiments/crf_codegen/**/*.py[cod]
experiments/crf_codegen/**/.ipynb_checkpoints/
# heavy, re-derivable run payloads: rendered page images (~78 MB), verbatim LLM
# call logs (~43 MB), and the renamed old-run backups (~41 MB). The interpretable
# results (clusters/trails/fields/prompts/replies/timings/summaries) stay tracked.
experiments/crf_codegen/**/*.png
experiments/crf_codegen/**/llm_calls/
experiments/crf_codegen/data/runs/snapshots/
# scratch scripts + stray default output dirs
experiments/crf_codegen/tmp/
experiments/crf_codegen/outdir/
/outdir/
# zip bundles are transport, not results: the Dataiku download zips duplicate the
# extracted run artifacts, and folder_code.zip is rebuilt from folder_code/ before
# each upload - a committed copy would only ever be a stale twin of the modules.
experiments/crf_codegen/data/runs/**/*.zip
experiments/crf_codegen/notebooks/folder_code.zip
